# Copy this file to .env.local for local secret overrides.
# .env.local is gitignored. Per-env files (.env.dev, .env.staging, .env.prod)
# are committed with non-secret defaults and overridden here as needed.

# ── Auth ───────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

STANDARD_USER_EMAIL=user@example.com
STANDARD_USER_PASSWORD=changeme

# ── API ────────────────────────────────────────────────────────────────────────
API_KEY=your-api-key-here
